                      </Style>
                      <CanGrow>true</CanGrow>
                      <Value>=Round((Sum(Fields!ENERO.Value)+Sum(Fields!FEBRERO.Value)+Sum(Fields!MARZO.Value)+Sum(Fields!ABRIL.Value)+Sum(Fields!MAYO.Value)+Sum(Fields!JUNIO.Value)+Sum(Fields!JULIO.Value)+Sum(Fields!AGOSTO.Value)+Sum(Fields!SETIEMBRE.Value)+Sum(Fields!OCTUBRE.Value)+Sum(Fields!NOVIEMBRE.Value)+Sum(Fields!DICIEMBRE.Value))/First(Fields!CANTIDADMES.Value, "dsPerContratado_PerCant"),2)</Value>
