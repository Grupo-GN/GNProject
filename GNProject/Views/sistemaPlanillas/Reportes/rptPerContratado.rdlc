                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                      <CanGrow>true</CanGrow>
                      <Value>=ROUND((Sum((IIf(Fields!ENERO.Value&gt;0,Fields!ENERO_ANT.Value,0)))+Sum(IIf(Fields!FEBRERO.Value&gt;0,Fields!FEBRERO_ANT.Value,0))+Sum(IIf(Fields!MARZO.Value&gt;0,Fields!MARZO_ANT.Value,0))+ Sum(IIf(Fields!ABRIL.Value&gt;0,Fields!ABRIL_ANT.Value,0))+ Sum(IIf(Fields!MAYO.Value&gt;0,Fields!MAYO_ANT.Value,0))+Sum(IIf(Fields!JUNIO.Value&gt;0,Fields!JUNIO_ANT.Value,0))+Sum(IIf(Fields!JULIO.Value&gt;0,Fields!JULIO_ANT.Value,0))+Sum(IIf(Fields!AGOSTO.Value&gt;0,Fields!AGOSTO_ANT.Value,0))+Sum(IIf(Fields!SETIEMBRE.Value&gt;0,Fields!SETIEMBRE_ANT.Value,0))+Sum(IIf(Fields!OCTUBRE.Value&gt;0,Fields!OCTUBRE_ANT.Value,0))+Sum(IIf(Fields!NOVIEMBRE.Value&gt;0,Fields!NOVIEMBRE_ANT.Value,0))+Sum(IIf(Fields!DICIEMBRE.Value,Fields!DICIEMBRE_ANT.Value,0)))/First(Fields!CANTIDADMES.Value, "dsPerContratado_PerCant"),2)</Value>
