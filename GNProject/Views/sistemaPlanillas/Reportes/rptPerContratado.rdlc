                      <Value>=ROUND((Sum(IIf((Fields!ENERO.Value)&gt;0,Fields!ENERO.Value-Fields!ENERO_ANT.Value,0))+Sum(IIf((Fields!FEBRERO.Value)&gt;0,Fields!FEBRERO.Value-Fields!FEBRERO_ANT.Value,0))+Sum(IIf((Fields!MARZO.Value)&gt;0,Fields!MARZO.Value-Fields!MARZO_ANT.Value,0))+Sum(IIf((Fields!ABRIL.Value)&gt;0,Fields!ABRIL.Value-Fields!ABRIL_ANT.Value,0))+Sum(IIf((Fields!MAYO.Value)&gt;0,Fields!MAYO.Value-Fields!MAYO_ANT.Value,0))+Sum(IIf((Fields!JUNIO.Value)&gt;0,Fields!JUNIO.Value-Fields!JUNIO_ANT.Value,0))+Sum(IIf((Fields!JULIO.Value)&gt;0,Fields!JULIO.Value-Fields!JULIO_ANT.Value,0))+ Sum(IIf((Fields!AGOSTO.Value)&gt;0,Fields!AGOSTO.Value-Fields!AGOSTO_ANT.Value,0))+ Sum(IIf((Fields!SETIEMBRE.Value)&gt;0,Fields!SETIEMBRE.Value-Fields!SETIEMBRE_ANT.Value,0))+ Sum(IIf((Fields!OCTUBRE.Value)&gt;0,Fields!OCTUBRE.Value-Fields!OCTUBRE_ANT.Value,0))+ Sum(IIf((Fields!NOVIEMBRE.Value)&gt;0,Fields!NOVIEMBRE.Value-Fields!NOVIEMBRE_ANT.Value,0))+Sum(IIf((Fields!DICIEMBRE.Value)&gt;0,Fields!DICIEMBRE.Value-Fields!DICIEMBRE_ANT.Value,0))/First(Fields!CANTIDADMES.Value, "dsPerContratado_PerCant")),2)</Value>
