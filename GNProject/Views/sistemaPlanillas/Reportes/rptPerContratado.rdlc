                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                      <CanGrow>true</CanGrow>
                      <Value>=ROUND(((Sum(Fields!ENERO.Value-Fields!ENERO_PPTO.Value))+(Sum(Fields!FEBRERO.Value-Fields!FEBRERO_PPTO.Value))+(Sum(Fields!MARZO.Value-Fields!MARZO_PPTO.Value))+(Sum(Fields!ABRIL.Value-Fields!ABRIL_PPTO.Value))+(Sum(Fields!MAYO.Value-Fields!MAYO_PPTO.Value))+(Sum(Fields!JUNIO.Value-Fields!JUNIO_PPTO.Value))+(Sum(Fields!JULIO.Value-Fields!JULIO_PPTO.Value))+(Sum(Fields!AGOSTO.Value-Fields!AGOSTO_PPTO.Value))+(Sum(Fields!SETIEMBRE.Value-Fields!SETIEMBRE_PPTO.Value))+(Sum(Fields!OCTUBRE.Value-Fields!OCTUBRE_PPTO.Value))+(Sum(Fields!NOVIEMBRE.Value-Fields!NOVIEMBRE_PPTO.Value))+(Sum(Fields!DICIEMBRE.Value-Fields!DICIEMBRE_PPTO.Value)))/First(Fields!CANTIDADMES.Value, "dsPerContratado_PerCant"),2)</Value>
